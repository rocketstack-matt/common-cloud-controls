{
  "$schema": "https://calm.finos.org/common-cloud-controls/architectures/three-tier-web-app/patterns/three-tier-web-app.pattern.json",
  "unique-id": "three-tier-web-app-pattern",
  "name": "Three-Tier Web Application Pattern",
  "description": "A CALM pattern for a generic three-tier web application, adaptable to multiple cloud providers.",
  "nodes": [
    {
      "unique-id": "webtier",
      "name": "Web Tier",
      "description": "The logical web tier, containing web server VMs.",
      "node-type": "compute"
    },
    {
      "unique-id": "app-tier",
      "name": "Application Tier",
      "description": "The logical application tier, containing application server VMs.",
      "node-type": "compute"
    },
    {
      "unique-id": "db-tier",
      "name": "Database Tier",
      "description": "The logical database tier, containing the database instance.",
      "node-type": "database"
    },
    {
      "unique-id": "webtier-ec2-vms",
      "name": "Amazon EC2 VMs",
      "description": "The virtual machines in the web tier delivered by Amazon EC2.",
      "node-type": "compute",
      "ccc-service": "Virtual Machines (VMs)",
      "csp-service": "Amazon EC2 Auto Scaling with Launch Templates"
    },
    {
      "unique-id": "aws-app-server-vms",
      "name": "Amazon EC2 App Server VMs",
      "description": "The virtual machines in the application tier delivered by Amazon EC2.",
      "node-type": "compute",
      "ccc-service": "Virtual Machines (VMs)",
      "csp-service": "Amazon EC2 Auto Scaling with Launch Templates"
    },
    {
      "unique-id": "aws-rds",
      "name": "Amazon RDS",
      "description": "The database instance delivered by Amazon RDS.",
      "node-type": "database",
      "ccc-service": "Relational Database Management Systems",
      "csp-service": "Amazon RDS for PostgreSQL / MySQL"
    },
    {
      "unique-id": "aws-external-lb",
      "name": "AWS External Load Balancer",
      "description": "The external load balancer, distributing traffic to the web tier.",
      "node-type": "load-balancer",
      "ccc-service": "Load Balancing",
      "csp-service": "Elastic Load Balancing – Application Load Balancer (ALB)"
    },
    {
      "unique-id": "aws-internal-lb",
      "name": "AWS Internal Load Balancer",
      "description": "The internal load balancer, distributing traffic from the web tier to the app tier.",
      "node-type": "load-balancer",
      "ccc-service": "Load Balancing",
      "csp-service": "Elastic Load Balancing – Network Load Balancer (NLB)"
    },
    {
      "unique-id": "aws-vpc",
      "name": "Amazon Virtual Private Cloud (VPC)",
      "description": "The virtual private cloud providing an isolated network environment.",
      "node-type": "network",
      "ccc-service": "Virtual Private Cloud (VPC)",
      "csp-service": "Amazon Virtual Private Cloud (VPC)"
    },
    {
      "unique-id": "aws-subnet",
      "name": "AWS Subnet",
      "description": "The subnet for application components.",
      "node-type": "network",
      "ccc-service": "Subnet",
      "csp-service": "Amazon VPC Subnets"
    },
    {
      "unique-id": "application-user",
      "name": "Application User",
      "description": "A user of the application.",
      "node-type": "actor"
    },
    {
      "unique-id": "aws-provider",
      "name": "Amazon Web Services (AWS)",
      "description": "The AWS provider.",
      "node-type": "cloud-provider"
    },
    {
      "unique-id": "aws-s3",
      "name": "Amazon S3",
      "description": "The object storage service from AWS.",
      "node-type": "storage",
      "ccc-service": "Object Storage",
      "csp-service": "Amazon Simple Storage Service (Amazon S3)"
    }
  ],
  "relationships": [
    {
      "unique-id": "webtier-composed-of-amazon-vms",
      "relationship-type": {
        "composed-of": {
          "container": "webtier",
          "nodes": [
            "webtier-ec2-vms"
          ]
        }
      }
    },
    {
      "unique-id": "app-tier-composed-of-aws-vms",
      "relationship-type": {
        "composed-of": {
          "container": "app-tier",
          "nodes": [
            "aws-app-server-vms"
          ]
        }
      }
    },
    {
      "unique-id": "db-tier-composed-of-aws-rds",
      "relationship-type": {
        "composed-of": {
          "container": "db-tier",
          "nodes": [
            "aws-rds"
          ]
        }
      }
    },
    {
      "unique-id": "external-lb-to-webtier-aws",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "aws-external-lb"
          },
          "destination": {
            "node": "webtier"
          }
        }
      }
    },
    {
      "unique-id": "webtier-to-internal-lb-aws",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "webtier"
          },
          "destination": {
            "node": "aws-internal-lb"
          }
        }
      }
    },
    {
      "unique-id": "internal-lb-to-app-tier-aws",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "aws-internal-lb"
          },
          "destination": {
            "node": "app-tier"
          }
        }
      }
    },
    {
      "unique-id": "app-tier-to-db-tier",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "app-tier"
          },
          "destination": {
            "node": "db-tier"
          }
        }
      }
    },
    {
      "unique-id": "db-tier-to-object-store-aws",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "aws-rds"
          },
          "destination": {
            "node": "aws-s3"
          }
        }
      }
    },
    {
      "unique-id": "components-in-subnet-aws",
      "relationship-type": {
        "deployed-in": {
          "container": "aws-subnet",
          "nodes": [
            "webtier",
            "app-tier",
            "db-tier",
            "aws-internal-lb",
            "aws-external-lb"
          ]
        }
      }
    },
    {
      "unique-id": "subnet-in-vpc-aws",
      "relationship-type": {
        "composed-of": {
          "container": "aws-vpc",
          "nodes": [
            "aws-subnet"
          ]
        }
      }
    },
    {
      "unique-id": "user-connects-to-lb-aws",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "application-user"
          },
          "destination": {
            "node": "aws-external-lb"
          }
        }
      }
    },
    {
      "unique-id": "csp-selection",
      "description": "Select the Cloud Service Provider for the architecture.",
      "relationship-type": {
        "options": [
          {
            "description": "Amazon Web Services (AWS)",
            "nodes": [
              "webtier-ec2-vms",
              "aws-app-server-vms",
              "aws-rds",
              "aws-external-lb",
              "aws-internal-lb",
              "aws-vpc",
              "aws-subnet",
              "aws-provider",
              "aws-s3"
            ],
            "relationships": [
              "webtier-composed-of-amazon-vms",
              "app-tier-composed-of-aws-vms",
              "db-tier-composed-of-aws-rds",
              "external-lb-to-webtier-aws",
              "user-connects-to-lb-aws",
              "components-in-subnet-aws",
              "webtier-to-internal-lb-aws",
              "internal-lb-to-app-tier-aws",
              "app-tier-to-db-tier",
              "subnet-in-vpc-aws",
              "vpc-in-aws-provider",
              "db-tier-to-object-store-aws"
            ]
          }
        ]
      }
    },
    {
      "unique-id": "vpc-in-aws-provider",
      "relationship-type": {
        "composed-of": {
          "container": "aws-provider",
          "nodes": [
            "aws-vpc",
            "aws-s3"
          ]
        }
      }
    }
  ]
}