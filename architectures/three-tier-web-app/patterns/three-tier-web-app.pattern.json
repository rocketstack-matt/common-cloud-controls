{
    "$schema": "https://calm.finos.org/release/1.0-rc2/meta/calm.json",
    "$id": "https://raw.githubusercontent.com/finos/architecture-as-code/main/common-cloud-controls/architectures/three-tier-web-app/patterns/three-tier-web-app.pattern.json",
    "title": "Three-Tier Web Application Pattern",
    "description": "A CALM pattern for a generic three-tier web application, adaptable to multiple cloud providers.",
    "type": "object",
    "properties": {
        "nodes": {
            "type": "array",
            "prefixItems": [
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "webtier" },
                        "name": { "const": "Web Tier" },
                        "description": { "const": "The logical web tier, containing web server VMs." },
                        "node-type": { "const": "compute" }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "app-tier" },
                        "name": { "const": "Application Tier" },
                        "description": { "const": "The logical application tier, containing application server VMs." },
                        "node-type": { "const": "compute" }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "db-tier" },
                        "name": { "const": "Database Tier" },
                        "description": { "const": "The logical database tier, containing the database instance." },
                        "node-type": { "const": "database" }
                    }
                },
                {
                    "oneOf": [
                        {
                            "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                            "properties": {
                                "unique-id": { "const": "google-compute-engine-vms" },
                                "name": { "const": "Google Cloud VMs" },
                                "description": { "const": "The virtual machines in the web tier delivered by Google Cloud." },
                                "node-type": { "const": "compute" },
                                "ccc-service": { "const": "Virtual Machines (VMs)" },
                                "csp-service": { "const": "Compute Engine Managed Instance Group" }
                            }
                        },
                        {
                            "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                            "properties": {
                                "unique-id": { "const": "ec2-vms" },
                                "name": { "const": "Amazon EC2 VMs" },
                                "description": { "const": "The virtual machines in the web tier delivered by Amazon EC2." },
                                "node-type": { "const": "compute" },
                                "ccc-service": { "const": "Virtual Machines (VMs)" },
                                "csp-service": { "const": "Amazon EC2 Auto Scaling with Launch Templates" }
                            }
                        },
                        {
                            "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                            "properties": {
                                "unique-id": { "const": "azure-vms" },
                                "name": { "const": "Azure VMs" },
                                "description": { "const": "The virtual machines in the web tier delivered by Azure." },
                                "node-type": { "const": "compute" },
                                "ccc-service": { "const": "Virtual Machines (VMs)" },
                                "csp-service": { "const": "Azure Virtual Machine Scale Sets" }
                            }
                        }
                    ]
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "app-server-vms" },
                        "name": { "const": "Application Server VMs" },
                        "description": { "const": "The virtual machines in the application tier." },
                        "node-type": { "const": "compute" }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "database-instance" },
                        "name": { "const": "Database Instance" },
                        "description": { "const": "The database instance for data persistence." },
                        "node-type": { "const": "database" }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "external-lb" },
                        "name": { "const": "External Load Balancer" },
                        "description": { "const": "The external load balancer, distributing traffic to the web tier." },
                        "node-type": { "const": "load-balancer" },
                        "metadata": {
                            "type": "array",
                            "prefixItems": [
                                {
                                    "type": "object",
                                    "properties": {
                                        "ccc-service": { "const": "Load Balancing" }
                                    }
                                }
                            ]
                        }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "internal-lb" },
                        "name": { "const": "Internal Load Balancer" },
                        "description": { "const": "The internal load balancer, distributing traffic from the web tier to the app tier." },
                        "node-type": { "const": "load-balancer" }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "vpc" },
                        "name": { "const": "Virtual Private Cloud" },
                        "description": { "const": "The virtual private cloud providing an isolated network environment." },
                        "node-type": { "const": "network" }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "subnet" },
                        "name": { "const": "Subnet" },
                        "description": { "const": "The subnet for application components." },
                        "node-type": { "const": "network" }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/node",
                    "properties": {
                        "unique-id": { "const": "application-user" },
                        "name": { "const": "Application User" },
                        "description": { "const": "A user of the application." },
                        "node-type": { "const": "actor" }
                    }
                }
            ]
        },
        "relationships": {
            "type": "array",
            "prefixItems": [
                {
                    "oneOf": [
                        {
                            "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                            "properties": {
                                "unique-id": { "const": "webtier-composed-of-google-vms" },
                                "relationship-type": { "const": { "composed-of": { "container": "webtier", "nodes": ["google-compute-engine-vms"] } } }
                            }
                        },
                        {
                            "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                            "properties": {
                                "unique-id": { "const": "webtier-composed-of-amazon-vms" },
                                "relationship-type": { "const": { "composed-of": { "container": "webtier", "nodes": ["ec2-vms"] } } }
                            }
                        },
                        {
                            "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                            "properties": {
                                "unique-id": { "const": "webtier-composed-of-azure-vms" },
                                "relationship-type": { "const": { "composed-of": { "container": "webtier", "nodes": ["azure-vms"] } } }
                            }
                        }
                    ]
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "app-tier-composed-of-vms" },
                        "relationship-type": { "const": { "composed-of": { "container": "app-tier", "nodes": ["app-server-vms"] } } }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "db-tier-composed-of-instance" },
                        "relationship-type": { "const": { "composed-of": { "container": "db-tier", "nodes": ["database-instance"] } } }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "external-lb-to-webtier" },
                        "relationship-type": { "const": { "connects": { "source": { "node": "external-lb" }, "destination": { "node": "webtier" } } } }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "webtier-to-internal-lb" },
                        "relationship-type": { "const": { "connects": { "source": { "node": "web-server-vms" }, "destination": { "node": "internal-lb" } } } }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "internal-lb-to-app-tier" },
                        "relationship-type": { "const": { "connects": { "source": { "node": "internal-lb" }, "destination": { "node": "app-tier" } } } }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "app-tier-to-db-tier" },
                        "relationship-type": { "const": { "connects": { "source": { "node": "app-tier" }, "destination": { "node": "db-tier" } } } }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "components-in-subnet" },
                        "relationship-type": {
                            "const": {
                                "deployed-in": {
                                    "container": "subnet",
                                    "nodes": ["webtier", "app-tier", "db-tier", "internal-lb", "external-lb"]
                                }
                            }
                        }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "subnet-in-vpc" },
                        "relationship-type": { "const": { "composed-of": { "container": "vpc", "nodes": ["subnet"] } } }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "user-connects-to-lb" },
                        "relationship-type": { "const": { "connects": { "source": { "node": "application-user" }, "destination": { "node": "external-lb" } } } }
                    }
                },
                {
                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/relationship",
                    "properties": {
                        "unique-id": { "const": "csp-selection" },
                        "description": { "const": "Select the Cloud Service Provider for the architecture." },
                        "relationship-type": {
                            "type": "object",
                            "properties": {
                                "options": {
                                    "type": "array",
                                    "minItems": 1,
                                    "maxItems": 1,
                                    "prefixItems": [
                                        {
                                            "oneOf": [
                                                {
                                                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/decision",
                                                    "type": "object",
                                                    "properties": {
                                                        "description": { "const": "Google Cloud" },
                                                        "nodes": {
                                                            "const": ["google-compute-engine-vms"]
                                                        },
                                                        "relationships": {
                                                            "const": ["webtier-composed-of-google-vms"]
                                                        }
                                                    }
                                                },
                                                {
                                                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/decision",
                                                    "type": "object",
                                                    "properties": {
                                                        "description": { "const": "Amazon Web Services (AWS)" },
                                                        "nodes": {
                                                            "const": ["ec2-vms"]
                                                        },
                                                        "relationships": {
                                                            "const": ["webtier-composed-of-amazon-vms"]
                                                        }
                                                    }
                                                },
                                                {
                                                    "$ref": "https://calm.finos.org/release/1.0-rc1/meta/core.json#/defs/decision",
                                                    "properties": {
                                                        "description": { "const": "Microsoft Azure" },
                                                        "nodes": {
                                                            "const": ["azure-vms"]
                                                        },
                                                        "relationships": {
                                                            "const": ["webtier-composed-of-azure-vms"]
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        }
    },
    "required": ["nodes", "relationships"]
}
