#!/bin/bash
# App Tier Startup Script  
# This script installs Docker and runs the containerized application server

set -e

# Variables from Terraform templatefile
APP_CONTAINER_IMAGE="${app_container_image}"
APP_CONTAINER_PORT="${app_container_port}"
DATABASE_IP="${database_ip}"
DATABASE_PORT="${database_port}"

# Update system packages
apt-get update
apt-get upgrade -y

# Install Docker
apt-get install -y ca-certificates curl gnupg lsb-release
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io

# Start Docker service
systemctl enable docker
systemctl start docker

# Wait for Docker to start
sleep 10

# Pull and run the application container
echo "Starting application container: ${app_container_image}" >> /var/log/app-startup.log

# Run the application container with database connection
docker run -d \
    --name app-container \
    --restart always \
    -p ${app_container_port}:${app_container_port} \
    -e DATABASE_HOST=${database_ip} \
    -e DATABASE_PORT=${database_port} \
    -e APP_PORT=${app_container_port} \
    ${app_container_image}

# Wait for container to start
sleep 15

# Check if container is running
if docker ps | grep -q app-container; then
    echo "✅ App container started successfully" >> /var/log/app-startup.log
    echo "Container started successfully" >> /var/log/app-startup.log
else
    echo "❌ Failed to start app container" >> /var/log/app-startup.log
    echo "Docker logs:" >> /var/log/app-startup.log
    docker logs app-container >> /var/log/app-startup.log 2>&1
    exit 1
fi

# Install and configure health check script
cat > /usr/local/bin/app-health-check.sh << 'EOF'
#!/bin/bash
# Check if app container is running and responding
if ! docker ps | grep -q app-container; then
    echo "App container not running"
    exit 1
fi

# Check if app is responding
curl -f http://localhost:${app_container_port}/health >/dev/null 2>&1
if [ $? -eq 0 ]; then
    echo "App health check passed"
    exit 0
else
    echo "App health check failed"
    exit 1
fi
EOF

chmod +x /usr/local/bin/app-health-check.sh

# Set up cron job for health checks
echo "*/2 * * * * /usr/local/bin/app-health-check.sh >> /var/log/app-health.log 2>&1" | crontab -

# Configure log rotation for app logs
cat > /etc/logrotate.d/app-logs << EOF
/var/log/app-*.log {
    daily
    compress
    copytruncate
    delaycompress
    missingok
    notifempty
    rotate 30
}
EOF

# Create a simple status page
mkdir -p /var/www/html
cat > /var/www/html/app-status.html << EOF
<!DOCTYPE html>
<html>
<head>
    <title>App Tier Status</title>
</head>
<body>
    <h1>App Tier - Running</h1>
    <p>Container Image: ${app_container_image}</p>
    <p>Container Port: ${app_container_port}</p>
    <p>Database Connection: ${database_ip}:${database_port}</p>
    <p>Timestamp: \$(date)</p>
    <p>Hostname: \$(hostname)</p>
    <p>Docker Status: \$(docker ps | grep app-container)</p>
</body>
</html>
EOF

# Set up monitoring and logging
apt-get install -y rsyslog
systemctl enable rsyslog
systemctl start rsyslog

# Create startup completion marker
touch /var/log/app-startup-complete

echo "App tier startup completed successfully" >> /var/log/app-startup.log
echo "Container ${app_container_image} running on port ${app_container_port}" >> /var/log/app-startup.log
echo "Connected to database at ${database_ip}:${database_port}" >> /var/log/app-startup.log