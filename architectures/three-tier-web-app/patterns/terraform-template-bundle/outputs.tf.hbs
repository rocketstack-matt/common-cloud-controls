# Outputs for {{project_name}} Infrastructure
# Generated from CALM Architecture Model

{{#if (eq cloudProvider "azure")}}
output "resource_group_name" {
  description = "Name of the resource group"
  value       = azurerm_resource_group.main.name
}

output "resource_group_location" {
  description = "Location of the resource group"
  value       = azurerm_resource_group.main.location
}

output "public_ip_address" {
  description = "Public IP address of the load balancer"
  value       = azurerm_public_ip.lb.ip_address
}

output "load_balancer_fqdn" {
  description = "FQDN of the load balancer"
  value       = azurerm_public_ip.lb.fqdn
}

output "internal_load_balancer_ip" {
  description = "Private IP address of the internal load balancer"
  value       = azurerm_lb.internal.frontend_ip_configuration[0].private_ip_address
}

output "virtual_network_name" {
  description = "Name of the virtual network"
  value       = azurerm_virtual_network.main.name
}

output "virtual_network_id" {
  description = "ID of the virtual network"
  value       = azurerm_virtual_network.main.id
}

output "subnet_id" {
  description = "ID of the main subnet"
  value       = azurerm_subnet.main.id
}

output "web_vmss_name" {
  description = "Name of the web tier VM scale set"
  value       = azurerm_linux_virtual_machine_scale_set.web.name
}

output "app_vmss_name" {
  description = "Name of the app tier VM scale set"  
  value       = azurerm_linux_virtual_machine_scale_set.app.name
}

output "database_vm_name" {
  description = "Name of the database VM"
  value       = azurerm_linux_virtual_machine.db.name
}

output "database_private_ip" {
  description = "Private IP address of the database VM"
  value       = azurerm_network_interface.db.private_ip_address
}

output "application_url" {
  description = "URL to access the application"
  value       = "http://${azurerm_public_ip.lb.ip_address}"
}

output "app_tier_ssh_access" {
  description = "SSH access information for app tier VMs"
  value = {
    username = "azureuser"
    port     = 22
    vmss_name = azurerm_linux_virtual_machine_scale_set.app.name
    connect_command = "Use 'az vmss list-instances' to get instance IPs, then ssh -i ~/.ssh/terraform-key azureuser@<instance_ip>"
  }
  sensitive = false
}

output "database_ssh_access" {
  description = "SSH access information for database VM"
  value = {
    username = "azureuser"
    port     = 22
    host     = azurerm_network_interface.db.private_ip_address
    connect_command = "ssh -i ~/.ssh/id_rsa azureuser@${azurerm_network_interface.db.private_ip_address}"
  }
  sensitive = false
}
{{/if}}

{{#if (eq cloudProvider "aws")}}
# AWS outputs would go here
output "vpc_id" {
  description = "ID of the VPC"
  value       = "aws_vpc.main.id"
}

output "application_url" {
  description = "URL to access the application"
  value       = "http://aws-load-balancer-dns-name"
}
{{/if}}

{{#if (eq cloudProvider "gcp")}}
# GCP outputs would go here
output "network_name" {
  description = "Name of the VPC network"
  value       = "google_compute_network.main.name"
}

output "application_url" {
  description = "URL to access the application"
  value       = "http://gcp-load-balancer-ip"
}
{{/if}}

# Common outputs
output "project_name" {
  description = "Name of the project"
  value       = var.project_name
}

output "environment" {
  description = "Environment"
  value       = var.environment
}

output "location" {
  description = "Deployment location"
  value       = var.location
}

output "deployment_info" {
  description = "Deployment information"
  value = {
    project_name     = var.project_name
    environment      = var.environment
    cloud_provider   = "{{cloudProvider}}"
    web_vm_count     = var.web_vm_count
    app_vm_count     = var.app_vm_count
    database_type    = var.database_type
    deployment_time  = timestamp()
  }
}
