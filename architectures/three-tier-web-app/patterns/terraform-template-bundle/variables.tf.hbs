# Variables for {{project_name}} Infrastructure
# Generated from CALM Architecture Model

variable "project_name" {
  description = "Name of the project"
  type        = string
  default     = "{{project_name}}"
}

variable "environment" {
  description = "Environment (dev, staging, prod)"
  type        = string
  default     = "{{environment}}"
}

variable "location" {
  description = "Azure location for resources"
  type        = string
  default     = "{{location}}"
}

variable "web_vm_count" {
  description = "Number of web tier VMs"
  type        = number
  default     = {{web_vm_count}}
}

variable "web_vm_size" {
  description = "Size of web tier VMs"
  type        = string
  default     = "{{web_vm_size}}"
}

variable "web_container_image" {
  description = "Container image for web tier"
  type        = string
  default     = "{{web_container_image}}"
}

variable "web_container_port" {
  description = "Container port for web tier"
  type        = number
  default     = {{web_container_port}}
}

variable "app_vm_count" {
  description = "Number of app tier VMs"
  type        = number
  default     = {{app_vm_count}}
}

variable "app_vm_size" {
  description = "Size of app tier VMs"
  type        = string
  default     = "{{app_vm_size}}"
}

variable "app_container_image" {
  description = "Container image for app tier"
  type        = string
  default     = "{{app_container_image}}"
}

variable "app_container_port" {
  description = "Container port for app tier"
  type        = number
  default     = {{app_container_port}}
}

variable "database_vm_size" {
  description = "Size of database VM"
  type        = string
  default     = "{{database_vm_size}}"
}

variable "database_type" {
  description = "Type of database"
  type        = string
  default     = "{{database_type}}"
}

variable "database_container_image" {
  description = "Container image for database"
  type        = string
  default     = "{{database_container_image}}"
}

variable "database_container_port" {
  description = "Container port for database"
  type        = number
  default     = {{database_container_port}}
}

variable "database_root_password" {
  description = "Root password for database"
  type        = string
  default     = "SecurePassword123!"
  sensitive   = true
}

variable "database_name" {
  description = "Name of the database"
  type        = string
  default     = "appdb"
}

variable "vnet_address_space" {
  description = "Address space for the virtual network"
  type        = string
  default     = "{{vnet_address_space}}"
}

variable "common_tags" {
  description = "Common tags for all resources"
  type        = map(string)
  default     = {
    Project     = "{{project_name}}"
    Environment = "{{environment}}"
    Owner       = "{{owner}}"
    ManagedBy   = "Terraform"
    CreatedFrom = "CALM-Template"
  }
}

variable "ssh_public_key" {
  description = "SSH public key for VM access (provide via terraform.tfvars or command line)"
  type        = string
  # No default - must be provided at deployment time
}
