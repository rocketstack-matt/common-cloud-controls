# Terraform Configuration for {{project_name}}
# Generated from CALM Architecture Model
# Cloud Provider: {{cloudProvider}}

terraform {
  required_version = ">= 1.0"
  
  required_providers {
{{#if (eq cloudProvider "azure")}}
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.0"
    }
{{/if}}
{{#if (eq cloudProvider "aws")}}
    aws = {
      source  = "hashicorp/aws" 
      version = "~> 5.0"
    }
{{/if}}
{{#if (eq cloudProvider "gcp")}}
    google = {
      source  = "hashicorp/google"
      version = "~> 4.0"
    }
{{/if}}
  }
}

{{#if (eq cloudProvider "azure")}}
# Configure Azure Provider
provider "azurerm" {
  features {}
}

# Resource Group
resource "azurerm_resource_group" "main" {
  name     = "rg-${var.project_name}-${var.environment}"
  location = var.location
  
  tags = merge(var.common_tags, {
    calm-unique-id = "azure-provider"
  })
}

# Virtual Network
resource "azurerm_virtual_network" "main" {
  name                = "vnet-${var.project_name}-${var.environment}"
  address_space       = [var.vnet_address_space]
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  
  tags = merge(var.common_tags, {
    calm-unique-id = "azure-vnet"
  })
}

# Subnets (consolidated single subnet for all tiers)
resource "azurerm_subnet" "main" {
  name                 = "subnet-main-${var.project_name}-${var.environment}"
  resource_group_name  = azurerm_resource_group.main.name
  virtual_network_name = azurerm_virtual_network.main.name
  address_prefixes     = ["10.0.1.0/24"]
  
  # Note: Azure subnets do not support tags
}

# Network Security Groups for tier-specific security
resource "azurerm_network_security_group" "web" {
  name                = "nsg-web-${var.project_name}-${var.environment}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

  security_rule {
    name                       = "HTTP"
    priority                   = 1001
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "80"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }

  security_rule {
    name                       = "HTTPS"
    priority                   = 1002
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "443"
    source_address_prefix      = "*"
    destination_address_prefix = "*"
  }

  tags = merge(var.common_tags, {
    calm-unique-id = "web-tier-nsg"
  })
}

resource "azurerm_network_security_group" "app" {
  name                = "nsg-app-${var.project_name}-${var.environment}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

  security_rule {
    name                       = "AppTier"
    priority                   = 1001
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = var.app_container_port
    source_address_prefix      = "10.0.1.0/24"
    destination_address_prefix = "*"
  }

  tags = merge(var.common_tags, {
    calm-unique-id = "app-tier-nsg"
  })
}

resource "azurerm_network_security_group" "db" {
  name                = "nsg-db-${var.project_name}-${var.environment}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

  security_rule {
    name                       = "MongoDB"
    priority                   = 1001
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "27017"
    source_address_prefix      = "10.0.1.0/24"
    destination_address_prefix = "*"
  }

  tags = merge(var.common_tags, {
    calm-unique-id = "db-tier-nsg"
  })
}

# Public IP for Load Balancer
resource "azurerm_public_ip" "lb" {
  name                = "pip-lb-${var.project_name}-${var.environment}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  allocation_method   = "Static"
  sku                = "Standard"
  
  tags = merge(var.common_tags, {
    calm-unique-id = "azure-external-lb-ip"
  })
}

# External Load Balancer
resource "azurerm_lb" "main" {
  name                = "lb-${var.project_name}-${var.environment}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  sku                = "Standard"

  frontend_ip_configuration {
    name                 = "PublicIPAddress"
    public_ip_address_id = azurerm_public_ip.lb.id
  }

  tags = merge(var.common_tags, {
    calm-unique-id = "azure-external-lb"
  })
}

# Internal Load Balancer
resource "azurerm_lb" "internal" {
  name                = "lb-internal-${var.project_name}-${var.environment}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  sku                = "Standard"

  frontend_ip_configuration {
    name                          = "InternalIPAddress"
    subnet_id                     = azurerm_subnet.main.id
    private_ip_address_allocation = "Dynamic"
  }

  tags = merge(var.common_tags, {
    calm-unique-id = "azure-internal-lb"
  })
}

# Virtual Machine Scale Set for Web Tier
resource "azurerm_linux_virtual_machine_scale_set" "web" {
  name                = "vmss-web-${var.project_name}-${var.environment}"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  sku                 = var.web_vm_size
  instances           = var.web_vm_count
  
  disable_password_authentication = true

  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-focal"
    sku       = "20_04-lts-gen2"
    version   = "latest"
  }

  os_disk {
    storage_account_type = "Premium_LRS"
    caching              = "ReadWrite"
  }

  network_interface {
    name    = "web-nic"
    primary = true
    network_security_group_id = azurerm_network_security_group.web.id

    ip_configuration {
      name      = "internal"
      primary   = true
      subnet_id = azurerm_subnet.main.id
    }
  }

  admin_ssh_key {
    username   = "azureuser"
    public_key = var.ssh_public_key
  }

  admin_username = "azureuser"

  # Custom startup script to install Docker and run container
  custom_data = base64encode(templatefile("${path.module}/scripts/web-startup.sh", {
    web_container_image = var.web_container_image
    web_container_port  = var.web_container_port
    app_lb_ip          = azurerm_lb.internal.frontend_ip_configuration[0].private_ip_address
  }))

  tags = merge(var.common_tags, {
    calm-unique-id = "webtier-azure-vms"
  })
}

# Virtual Machine Scale Set for App Tier
resource "azurerm_linux_virtual_machine_scale_set" "app" {
  name                = "vmss-app-${var.project_name}-${var.environment}"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  sku                 = var.app_vm_size
  instances           = var.app_vm_count
  
  disable_password_authentication = true

  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-focal"
    sku       = "20_04-lts-gen2"
    version   = "latest"
  }

  os_disk {
    storage_account_type = "Premium_LRS"
    caching              = "ReadWrite"
  }

  network_interface {
    name    = "app-nic"
    primary = true
    network_security_group_id = azurerm_network_security_group.app.id

    ip_configuration {
      name                                   = "internal"
      primary                                = true
      subnet_id                              = azurerm_subnet.main.id
      load_balancer_backend_address_pool_ids = [azurerm_lb_backend_address_pool.internal.id]
    }
  }

  admin_ssh_key {
    username   = "azureuser"
    public_key = var.ssh_public_key
  }

  admin_username = "azureuser"

  # Custom startup script to install Docker and run container
  custom_data = base64encode(templatefile("${path.module}/scripts/app-startup.sh", {
    app_container_image = var.app_container_image
    app_container_port  = var.app_container_port
    database_ip        = "10.0.1.10"  # Database VM IP in single subnet
    database_port      = var.database_container_port
  }))

  tags = merge(var.common_tags, {
    calm-unique-id = "azure-app-server-vms"
  })
}

# Internal Load Balancer Backend Pool
resource "azurerm_lb_backend_address_pool" "internal" {
  loadbalancer_id = azurerm_lb.internal.id
  name            = "BackEndAddressPool"
}

# Internal Load Balancer Health Probe
resource "azurerm_lb_probe" "internal" {
  loadbalancer_id = azurerm_lb.internal.id
  name            = "app-health-probe"
  port            = var.app_container_port
  protocol        = "Http"
  request_path    = "/health"
}

# Internal Load Balancer Rule
resource "azurerm_lb_rule" "internal" {
  loadbalancer_id                = azurerm_lb.internal.id
  name                           = "LBRule"
  protocol                       = "Tcp"
  frontend_port                  = var.app_container_port
  backend_port                   = var.app_container_port
  frontend_ip_configuration_name = "InternalIPAddress"
  backend_address_pool_ids       = [azurerm_lb_backend_address_pool.internal.id]
  probe_id                       = azurerm_lb_probe.internal.id
}

# Virtual Machine for Database
resource "azurerm_linux_virtual_machine" "db" {
  name                = "vm-db-${var.project_name}-${var.environment}"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  size                = var.database_vm_size
  admin_username      = "azureuser"

  disable_password_authentication = true

  network_interface_ids = [
    azurerm_network_interface.db.id,
  ]

  admin_ssh_key {
    username   = "azureuser"
    public_key = var.ssh_public_key
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Premium_LRS"
  }

  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-focal"
    sku       = "20_04-lts-gen2"
    version   = "latest"
  }

  # Custom startup script to install Docker and run database container
  custom_data = base64encode(templatefile("${path.module}/scripts/db-startup.sh", {
    database_container_image = var.database_container_image
    database_container_port  = var.database_container_port
    database_root_password   = var.database_root_password
    database_name           = var.database_name
  }))

  tags = merge(var.common_tags, {
    calm-unique-id = "azure-mongodb-vm"
  })
}

# Network Interface for Database VM
resource "azurerm_network_interface" "db" {
  name                = "nic-db-${var.project_name}-${var.environment}"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.main.id
    private_ip_address_allocation = "Static"
    private_ip_address            = "10.0.1.10"
  }

  tags = merge(var.common_tags, {
    calm-unique-id = "azure-mongodb-vm-nic"
  })
}

# Associate Database NSG with Database NIC
resource "azurerm_network_interface_security_group_association" "db" {
  network_interface_id      = azurerm_network_interface.db.id
  network_security_group_id = azurerm_network_security_group.db.id
}
{{/if}}
